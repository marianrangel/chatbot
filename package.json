{
  "name": "gemini-chat-serve",
  "version": "1.0.0",
  "description": "Servidor Node.js com Express para chat com API Gemini",
  "main": "serve.js",
  "scripts": {
    "start:backend": "node serve.js",
    "start:frontend": "react-scripts start",
